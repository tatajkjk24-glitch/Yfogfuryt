       AntiKickEnabled = Value
   end,
})

ProtectionTab:CreateParagraph({
    Title = "🛡️ حالة الحماية",
    Content = "نظام الـ Anti-Kick يعمل حالياً في الخلفية ويمنع السكربتات المحلية وأنظمة الحماية من طردك."
})

local LocalPlayer = game:GetService("Players").LocalPlayer
local OldNamecall
local OldKick

-- Hook للطرد المباشر
OldKick = hookfunction(LocalPlayer.Kick, function(self, ...)
    if AntiKickEnabled and self == LocalPlayer then
        Rayfield:Notify({
            Title = "صمله سواد",
            Content = "🛡️ تم منع محاولة كيك (Kick Direct)!",
            Duration = 5,
            Image = 4483362458,
        })
        return nil
    end
    return OldKick(self, ...)
end)

-- Hook للطرد عبر __namecall
OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local Method = getnamecallmethod()
    if AntiKickEnabled and self == LocalPlayer and string.lower(Method) == "kick" then
        Rayfield:Notify({
            Title = "صمله سواد",
            Content = "🛡️ تم اعتراض وتخطي حماية Kick خفية!",
            Duration = 5,
            Image = 4483362458,
        })
        return nil
    end
    return OldNamecall(self, ...)
end)

-- إعادة الاتصال عند ظهور نافذة Error
