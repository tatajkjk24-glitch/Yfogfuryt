-- تحديث العداد
task.spawn(function()
    while task.wait(1) do
        local Elapsed = math.floor(tick() - StartTime)
        local Hours = math.floor(Elapsed / 3600)
        local Minutes = math.floor((Elapsed % 3600) / 60)
        local Seconds = Elapsed % 60
        
        local TimeFormatted = string.format("%02d:%02d:%02d", Hours, Minutes, Seconds)
        
        TimerParagraph:Set({
            Title = "⏱️ وقت التواجد في اللعبة",
            Content = TimeFormatted
        })
        
        if BlackScreenText then
            BlackScreenText.Text = "صمله سواد - وضع الـ AFK مفعل\nمدة التواجد: " .. TimeFormatted
        end
    end
end)
