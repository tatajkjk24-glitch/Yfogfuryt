UltraAfkTab:CreateSection("حركة AFK المستمرة والفعالة")

-- نظام الـ AFK المستمر بالحركة
local AdvancedAfkActive = false
UltraAfkTab:CreateToggle({
   Name = "👑 نظام الـ AFK الذكي (حركة مستمرة ونقر)",
   CurrentValue = false,
   Callback = function(Value)
       AdvancedAfkActive = Value
       if Value then
           Rayfield:Notify({Title = "AFK الذكي 👑", Content = "تم تفعيل الحركة المستمرة للشخصية!"})
           task.spawn(function()
               local VirtualUser = game:GetService("VirtualUser")
               while AdvancedAfkActive do
                   -- نقرة وهمية
                   VirtualUser:CaptureController()
                   VirtualUser:ClickButton2(Vector2.new())

                   local char = game.Players.LocalPlayer.Character
                   if char and char:FindFirstChild("Humanoid") then
                       -- تحريك الشخصية خطوة لليمن ثم خطوة لليسار والقفز
                       char.Humanoid:Move(Vector3.new(2, 0, 0), false)
                       task.wait(0.5)
                       char.Humanoid:Move(Vector3.new(-2, 0, 0), false)
                       task.wait(0.5)
                       char.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                   end
                   task.wait(5) -- تكرار الحركة كل 5 ثوانٍ
               end
           end)
       else
           Rayfield:Notify({Title = "AFK الذكي 👑", Content = "تم إيقاف حركة الـ AFK."})
       end
   end,
})

-- منع التعليق والتجميد تلقائياً (Anti-Stuck System)
local AntiStuckActive = false
UltraAfkTab:CreateToggle({
   Name = "🌀 منع تعليق الشخصية (Anti-Stuck Teleport)",
   CurrentValue = false,
   Callback = function(Value)
       AntiStuckActive = Value
       if Value then
           Rayfield:Notify({Title = "Anti-Stuck 🌀", Content = "تم تفعيل نظام الإنعاش الذاتي عند التعليق!"})
           task.spawn(function()
               while AntiStuckActive do
                   local char = game.Players.LocalPlayer.Character
                   if char and char:FindFirstChild("HumanoidRootPart") then
                       local lastPos = char.HumanoidRootPart.Position
                       task.wait(60)
                       if AntiStuckActive and (char.HumanoidRootPart.Position - lastPos).Magnitude < 1 then
                           char.HumanoidRootPart.CFrame = char.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                       end
                   else
                       task.wait(5)
                   end
               end
           end)
       else
           Rayfield:Notify({Title = "Anti-Stuck 🌀", Content = "تم إيقاف نظام منع التعليق."})
       end
   end,
})

