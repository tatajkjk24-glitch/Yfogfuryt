DefenseTab:CreateSection("حماية الحساب من الطرد البرمجي (Anti-Kick Guard)")
local AntiKickHookEnabled = false
local OldNamecall = nil

DefenseTab:CreateToggle({
   Name = "🛡️ درع حماية الكيك الخارق (Anti-Kick)",
   CurrentValue = false,
   Callback = function(Value)
       AntiKickHookEnabled = Value
       if Value then
           if not OldNamecall and hookmetamethod then
               OldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                   local method = getnamecallmethod()
                   if AntiKickHookEnabled and (method == "Kick" or method == "kick") then
                       Rayfield:Notify({Title = "درع سواد 🛡️", Content = "تم منع محاولة طرد الحساب (Kick)!"})
                       return nil
                   end
                   return OldNamecall(self, ...)
               end)
           end
           Rayfield:Notify({Title = "حماية الكيك", Content = "تم تفعيل الدرع ضد الكيك البرمجي!"})
       else
           Rayfield:Notify({Title = "حماية الكيك", Content = "تم إيقاف درع حماية الكيك."})
       end
   end,
})
