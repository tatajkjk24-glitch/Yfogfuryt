-- HTTP
local function req(opt)
    if typeof(request) == "function" then
        local r = request(opt); return r.Body or r
    elseif typeof(http_request) == "function" then
        local r = http_request(opt); return r.Body or r
    end
    if opt.Method == "GET" then return game:HttpGet(opt.Url) end
end

