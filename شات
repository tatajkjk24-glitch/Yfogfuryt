--============== 📡 دالة HTTP ==============--
local function httpRequest(opts)
    -- دعم عدة تنفيذات
    if typeof(request) == "function" then
        local res = request(opts)
        return res.Body or res.body or res
    elseif typeof(http_request) == "function" then
        local res = http_request(opts)
        return res.Body or res.body or res
    elseif typeof(syn) == "table" and syn.request then
        local res = syn.request(opts)
        return res.Body or res.body or res
    else
        -- احتياط: HttpGet فقط لـ GET
        if opts.Method == "GET" then
            return game:HttpGet(opts.Url)
        end
    end
    return nil
end

