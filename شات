local function showHeadMessage(player, text, duration)
    if not player or not player.Character then return end
    duration = duration or CONFIG.HeadMsgDuration

    local data = headMessages[player.Character]
    if not data or not data.Parent then
        data = createHeadBillboard(player.Character)
        if not data then return end
    end

    local frame = data:FindFirstChildWhichIsA("Frame")
    if not frame then return end
    local label = frame:FindFirstChildWhichIsA("TextLabel")
    if not label then return end

    label.Text = text
    task.wait()
    local textBounds = label.TextBounds
    data.Size = UDim2.new(
        0,
        math.clamp(textBounds.X + 30, 80, 400),
        0,
        math.clamp(textBounds.Y + 20, 34, 120)
    )

    frame.Visible = true
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0, 0, 0, 8)
    TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0.15,
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(duration, function()
        if frame and frame.Parent then
            local out = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad), {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, -8)
            })
            out:Play()
            out.Completed:Connect(function()
                if frame and frame.Parent then
                    frame.Visible = false
                end
            end)
        end
    end)
end

