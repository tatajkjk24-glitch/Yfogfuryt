local headMessages = {}
local activeHeads = {}  -- يمنع التكرار

local function createHeadBillboard(character)
    if not character then return nil end
    local head = character:FindFirstChild("Head")
    if not head then return nil end

    local old = head:FindFirstChild("DeltaHeadMsg")
    if old then old:Destroy() end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DeltaHeadMsg"
    billboard.Size = UDim2.new(0, CONFIG.HeadMsgMaxWidth, 0, 40)
    billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.5 + CONFIG.HeadMsgOffset, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 200
    billboard.LightInfluence = 0
    billboard.Parent = head

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundColor3 = CONFIG.Colors.HeadBg
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Visible = false
    frame.Parent = billboard
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

    local stroke = Instance.new("UIStroke", frame)
    stroke.Color = CONFIG.Colors.Accent
    stroke.Thickness = 1.5

    local padding = Instance.new("UIPadding", frame)
    padding.PaddingTop = UDim.new(0, 6)
    padding.PaddingBottom = UDim.new(0, 6)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.PaddingRight = UDim.new(0, 10)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.TextColor3 = CONFIG.Colors.TextPrimary
    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextWrapped = true

    headMessages[character] = billboard
    return billboard
end

local function showHeadMessage(targetPlayer, text, duration)
    if not targetPlayer or not targetPlayer.Character then return end
    duration = duration or CONFIG.HeadMsgDuration

    -- منع التكرار خلال فترة قصيرة
    local now = tick()
    if activeHeads[targetPlayer] and now - activeHeads[targetPlayer] < 0.5 then
        return
    end
    activeHeads[targetPlayer] = now

    local data = headMessages[targetPlayer.Character]
    if not data or not data.Parent then
        data = createHeadBillboard(targetPlayer.Character)
        if not data then return end
    end

    local frame = data:FindFirstChildWhichIsA("Frame")
    local label = frame and frame:FindFirstChildWhichIsA("TextLabel")
    if not label then return end

    label.Text = text
    task.wait()
    local tb = label.TextBounds
    data.Size = UDim2.new(
        0, math.clamp(tb.X + 30, 80, 400),
        0, math.clamp(tb.Y + 20, 34, 120)
    )

    frame.Visible = true
    frame.BackgroundTransparency = 1
    frame.Position = UDim2.new(0, 0, 0, 8)
    TweenService:Create(frame, TweenInfo.new(0.25, Enum.EasingStyle.Back), {
        BackgroundTransparency = 0.15,
        Position = UDim2.new(0, 0, 0, 0)
    }):Play()

    task.delay(duration, function()
        if frame and frame.Parent then
            local out = TweenService:Create(frame, TweenInfo.new(0.3), {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, -8)
            })
            out:Play()
            out.Completed:Connect(function()
                if frame and frame.Parent then
                    frame.Visible = false
                end
            end)
        end
    end)
end

local function setupPlayer(player)
    if player.Character then
        createHeadBillboard(player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        createHeadBillboard(char)
    end)
end

