local minimized   = false
local activeTween = nil

local FULL_SIZE = UDim2.new(0, CONFIG.Width, 0, CONFIG.Height)
local MINI_SIZE = UDim2.new(0, CONFIG.Width, 0, 40)

local function setMinimized(state)
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end

    minimized = state

    if state then
        minBtn.Text = "▣"
        minBtn.BackgroundColor3 = Color3.fromRGB(80, 200, 120)
        chatArea.Visible = false
        inputFrame.Visible = false
    else
        minBtn.Text = "—"
        minBtn.BackgroundColor3 = Color3.fromRGB(60, 65, 80)
        chatArea.Visible = true
        inputFrame.Visible = true
    end

    activeTween = TweenService:Create(
        main,
        TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        { Size = state and MINI_SIZE or FULL_SIZE }
    )
    activeTween:Play()
    activeTween.Completed:Connect(function()
        activeTween = nil
    end)
end

minBtn.MouseButton1Click:Connect(function()
    setMinimized(not minimized)
end)

