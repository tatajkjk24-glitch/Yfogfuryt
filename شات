-- إرسال رسالة للسيرفر
local function sendToServer(text)
    local payload = HttpService:JSONEncode({
        sender = lp.Name,
        text = text,
        time = math.floor(tick() * 1000)
    })

    task.spawn(function()
        local ok, res = pcall(function()
            return httpRequest({
                Url = CONFIG.ServerURL .. "/send",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payload
            })
        end)

        if ok and res then
            print("[Chat] ✅ أُرسلت:", text)
        else
            warn("[Chat] ❌ فشل الإرسال")
        end
    end)
end

-- استلام الرسائل الجديدة
local function pollMessages()
    while gui.Parent do
        task.wait(CONFIG.PollInterval)

        local url = CONFIG.ServerURL .. "/messages?since=" .. tostring(lastSeenId)
        local ok, res = pcall(function()
            return httpRequest({
                Url = url,
                Method = "GET"
            })
        end)

        if ok and res and type(res) == "string" and #res > 2 then
            connectionCheckFailCount = 0

            if not connected then
                connected = true
                setOnlineStatus(true)
            end

            local decoded
            local decOk = pcall(function()
                decoded = HttpService:JSONDecode(res)
            end)

            if decOk and decoded and decoded.messages then
                for _, m in ipairs(decoded.messages) do
                    if m.id > lastSeenId then
                        lastSeenId = m.id

                        -- تجاهل رسائلي (سبق عرضتها)
                        if m.sender ~= lp.Name then
                            -- عرض في الشات
                            addMessage(m.sender, m.text, "other")

                            -- عرض فوق رأس اللاعب لو موجود
                            local plr = Players:FindFirstChild(m.sender)
                            if plr then
                                showHeadMessage(plr, m.text)
                            end
                        end
                    end
                end
            end
        else
            connectionCheckFailCount = connectionCheckFailCount + 1
            if connectionCheckFailCount >= 3 and connected then
                connected = false
                setOnlineStatus(false)
            end
        end
    end
end

--============== إرسال ==============--
local lastSentTime = 0
local function sendMessage(text)
    if not text or #text == 0 then return end
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if #text == 0 then return end

    -- منع السبام (رسالة كل 0.5 ثانية)
    local now = tick()
    if now - lastSentTime < 0.5 then
        return
    end
    lastSentTime = now

    -- عرض فوري محلياً
    addMessage(lp.Name .. " (أنت)", text, "self")
    showHeadMessage(lp, text)

    -- إرسال للسيرفر
    sendToServer(text)
end

