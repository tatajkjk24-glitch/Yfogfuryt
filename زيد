-- دالة تحديث العرض النصي للخصم مع تايمر الوقت
local function UpdateTargetDisplay(data)
    if data and data.Label then
        local formattedTime = FormatTime(data.TotalTimeSpent or 0)
        data.Label:Set("👤 " .. data.OriginalName .. " | دخول: " .. tostring(data.Joins) .. " | خروج: " .. tostring(data.Leaves) .. " | ⏱️ " .. formattedTime)
    end
end

-- دالة الإضافة التلقائية عند كتابة أول حرفين أو أكثر
local function AddTargetSmart(input)
    if input == nil or #input < 2 then return end
    
    local cleanInput = string.lower(string.gsub(input, "^%s*(.-)%s*$", "%1"))
    local matchedPlayer = nil

    for _, plr in pairs(Players:GetPlayers()) do
        local nameLower = string.lower(plr.Name)
        local displayLower = string.lower(plr.DisplayName)
        
        if string.sub(nameLower, 1, #cleanInput) == cleanInput or string.sub(displayLower, 1, #cleanInput) == cleanInput then
            matchedPlayer = plr
            break
        end
    end

    local fullName = matchedPlayer and matchedPlayer.Name or input
    local lowerKey = string.lower(fullName)

    if TargetsData[lowerKey] then return end

    if EmptyLabel then
        EmptyLabel:Set("")
    end

    local isCurrentlyIn = matchedPlayer ~= nil
    local createdLabel = TrackerTab:CreateLabel("")

    TargetsData[lowerKey] = {
        OriginalName = fullName,
        Joins = isCurrentlyIn and 1 or 0,
        Leaves = 0,
        IsPresent = isCurrentlyIn,
        LastJoinTime = isCurrentlyIn and os.time() or nil,
        TotalTimeSpent = 0,
        Label = createdLabel
    }

    UpdateTargetDisplay(TargetsData[lowerKey])

    if matchedPlayer and string.lower(matchedPlayer.DisplayName) ~= string.lower(matchedPlayer.Name) then
        local displayKey = string.lower(matchedPlayer.DisplayName)
        TargetsData[displayKey] = TargetsData[lowerKey]
    end

    Rayfield:Notify({
       Title = "تكريتي~🇦🇱 Tracker",
       Content = "تم تسجيل الخصم مع التايمر: " .. fullName,
       Duration = 4,
       Image = 4483345998,
    })
end

