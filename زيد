-- دالة الحصول على بيانات الخصم
local function getTargetData(plr)
   local nameLower = string.lower(plr.Name)
   local displayLower = string.lower(plr.DisplayName)
   return TargetsData[nameLower] or TargetsData[displayLower]
end

-- حلقة الـ Timer المباشرة لتحديث ثواني وجود الخصم داخل السيرفر
task.spawn(function()
    while task.wait(1) do
        for _, data in pairs(TargetsData) do
            if data.IsPresent then
                data.TotalTimeSpent = data.TotalTimeSpent + 1
                UpdateTargetDisplay(data)
            end
        end
    end
end)

