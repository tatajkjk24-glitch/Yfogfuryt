-- دالة تحويل الثواني إلى صيغة وقت (ساعات:دقائق:ثواني)
local function FormatTime(seconds)
    local hours = math.floor(seconds / 3600)
    local mins = math.floor((seconds % 3600) / 60)
    local secs = math.floor(seconds % 60)
    return string.format("%02d:%02d:%02d", hours, mins, secs)
end

-- دالة خفض اللاق وإخفاء كافة تفاصيل الماب بالكامل
local function ApplyExtremeLagReducer()
    pcall(function()
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.Brightness = 1
        
        -- إخفاء التأثيرات والمؤثرات البيئية
        for _, v in pairs(Lighting:GetChildren()) do
            if v:IsA("PostEffect") or v:IsA("Atmosphere") or v:IsA("Sky") or v:IsA("Bloom") or v:IsA("Blur") then
                v:Destroy()
            end
        end

        -- مسح وإخفاء جميع تفاصيل الماب
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                obj.Material = Enum.Material.SmoothPlastic
                obj.CastShadow = false
                if not obj:IsDescendantOf(LocalPlayer.Character) then
                    obj.Transparency = 1 -- إخفاء كافة مجسمات الماب
                end
            elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SurfaceAppearance") then
                obj:Destroy()
            elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                obj.Enabled = false
                obj:Destroy()
            elseif obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
                -- الحفاظ على مظهر اللاعبين اختياري
            end
        end
    end)
end

