local function addMsg(sender, text, isSelf, isSystem)
    local count = 0
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("Frame") then count = count + 1 end
    end
    if count >= 60 then
        for _, c in ipairs(scroll:GetChildren()) do
            if c:IsA("Frame") then c:Destroy(); break end
        end
    end

    local f = Instance.new("Frame", scroll)
    f.BackgroundTransparency = 1
    f.Size = UDim2.new(1, 0, 0, 0)
    f.AutomaticSize = Enum.AutomaticSize.Y

    local l = Instance.new("UIListLayout", f)
    l.Padding = UDim.new(0, 2)

    local n = Instance.new("TextLabel", f)
    n.Size = UDim2.new(1, 0, 0, 14)
    n.BackgroundTransparency = 1
    n.Font = Enum.Font.GothamBold
    n.TextSize = 11
    n.TextXAlignment = Enum.TextXAlignment.Left
    n.Text = sender

    if isSystem then
        n.TextColor3 = Color3.fromRGB(255, 210, 100)
    elseif isSelf then
        n.TextColor3 = Color3.fromRGB(120, 180, 255)
    else
        n.TextColor3 = Color3.fromRGB(255, 170, 100)
    end

    local b = Instance.new("Frame", f)
    b.BorderSizePixel = 0
    b.AutomaticSize = Enum.AutomaticSize.Y
    b.Size = UDim2.new(1, 0, 0, 0)
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    if isSystem then
        b.BackgroundColor3 = Color3.fromRGB(60, 50, 30)
    elseif isSelf then
        b.BackgroundColor3 = Color3.fromRGB(45, 55, 85)
    else
        b.BackgroundColor3 = Color3.fromRGB(35, 38, 48)
    end

    local bp = Instance.new("UIPadding", b)
    bp.PaddingTop = UDim.new(0, 6)
    bp.PaddingBottom = UDim.new(0, 6)
    bp.PaddingLeft = UDim.new(0, 9)
    bp.PaddingRight = UDim.new(0, 9)

    local t = Instance.new("TextLabel", b)
    t.Size = UDim2.new(1, 0, 0, 0)
    t.AutomaticSize = Enum.AutomaticSize.Y
    t.BackgroundTransparency = 1
    t.Text = text
    t.TextColor3 = Color3.fromRGB(230, 232, 240)
    t.Font = Enum.Font.Gotham
    t.TextSize = 13
    t.TextWrapped = true
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Top

    task.defer(function()
        task.wait()
        TweenService:Create(scroll, TweenInfo.new(0.25), {
            CanvasPosition = Vector2.new(0,
                math.max(0, scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y))
        }):Play()
    end)
end

