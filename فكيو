-- ═══════ إرسال عبر TextChatService ═══════
local function sendChat(text)
    pcall(function()
        local channels = TextChatService:FindFirstChild("TextChannels")
        if channels then
            local rb = channels:FindFirstChild("RBXGeneral")
            if rb then
                rb:SendAsync(text)
                return true
            end
        end
    end)

    -- احتياط: ChatInputBar
    pcall(function()
        local bar = TextChatService:FindFirstChild("ChatInputBarConfiguration")
        if bar then
            bar.TextBox:CaptureFocus()
            task.wait(0.05)
            bar.TextBox.Text = text
            task.wait(0.05)
            bar.TextBox:ReleaseFocus()
        end
    end)
end

