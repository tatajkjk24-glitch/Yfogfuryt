local recent = {}

-- من TextChatService (الحديث)
pcall(function()
    TextChatService.MessageReceived:Connect(function(m)
        if not m or not m.TextSource then return end
        local sender = m.TextSource.Name or "?"
        if sender == lp.Name then return end

        local key = sender .. "|" .. m.Text .. "|" .. tostring(math.floor(tick() * 2))
        if recent[key] then return end
        recent[key] = true

        addMsg(sender, m.Text, false, false)
    end)
end)

-- تنظيف الذاكرة
task.spawn(function()
    while gui.Parent do
        task.wait(30)
        recent = {}
    end
end)

-- ═══ الإرسال ═══
local lastSent = 0

local function sendMessage(text)
    if not text or #text == 0 then return end
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if #text == 0 then return end

    local now = tick()
    if now - lastSent < 0.5 then return end
    lastSent = now

    addMsg(lp.Name .. " (أنت)", text, true, false)
    sendChat(text)
end

send.MouseButton1Click:Connect(function()
    if #txt.Text > 0 then
        sendMessage(txt.Text)
        txt.Text = ""
    end
end)

txt.FocusLost:Connect(function(enter)
    if enter and #txt.Text > 0 then
        sendMessage(txt.Text)
        txt.Text = ""
    end
end)

-- ═══ إخفاء/إظهار ═══
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightControl then
        main.Visible = not main.Visible
    end
end)

