ContentArea.Size = UDim2.new(1, -120, 1, -40)
ContentArea.Position = UDim2.new(0, 120, 0, 40)
ContentArea.BackgroundTransparency = 1

local function CreateTab(name)
    local Container = Instance.new("ScrollingFrame", ContentArea)
    Container.Size = UDim2.new(1, 0, 1, 0)
    Container.BackgroundTransparency = 1
    Container.Visible = false
    Container.ScrollBarThickness = 2
    local List = Instance.new("UIListLayout", Container)
    List.HorizontalAlignment = Enum.HorizontalAlignment.Center
    List.Padding = UDim.new(0, 5)
    
    local TabBtn = Instance.new("TextButton", Sidebar)
    TabBtn.Size = UDim2.new(1, 0, 0, 40)
    TabBtn.Text = name
    TabBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
    TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabBtn.MouseButton1Click:Connect(function()
        for _, v in pairs(ContentArea:GetChildren()) do if v:IsA("ScrollingFrame") then v.Visible = false end end
        Container.Visible = true
    end)
    return Container
end

