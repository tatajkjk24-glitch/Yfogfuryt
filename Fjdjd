-- خانة afk الرواقي
Tabs.AFK:AddSection("حماية مانع طرد الرواقي")

local AntiAFKActive = false
local AntiAFKConnections = {}

local AntiAFKToggle = Tabs.AFK:AddToggle("AntiAFK_Ultra", {Title = "تفعيل مانع طرد الرواقي القوي", Default = false })

AntiAFKToggle:OnChanged(function(Value)
    AntiAFKActive = Value
    if AntiAFKActive then
        local GC = getconnections or get_signal_cons
        if GC then
            for _, conn in pairs(GC(game:GetService("Players").LocalPlayer.Idled)) do
                if conn["Disable"] then conn:Disable() elseif conn["Disconnect"] then conn:Disconnect() end
            end
        end
        local VirtualUser = game:GetService("VirtualUser")
        AntiAFKConnections["Idled"] = game:GetService("Players").LocalPlayer.Idled:Connect(function()
            VirtualUser:CaptureController()
            VirtualUser:ClickButton2(Vector2.new())
        end)
        task.spawn(function()
            while AntiAFKActive do
                task.wait(60)
                if not AntiAFKActive then break end
                VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
                task.wait(0.2)
                VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            end
        end)
        Fluent:Notify({ Title = "تيم الرواقي", Content = "تم تفعيل مانع طرد الرواقي القوي!", Duration = 3 })
    else
        if AntiAFKConnections["Idled"] then AntiAFKConnections["Idled"]:Disconnect() AntiAFKConnections["Idled"] = nil end
        Fluent:Notify({ Title = "تيم الرواقي", Content = "تم إيقاف مانع طرد الرواقي.", Duration = 3 })
    end
end)

-- خانة تسجيل سواد (تم تصحيح طريقة التحديث لتجنب خطأ SetContent)
Tabs.Blacklist:AddSection("مراقبة الخصم وتسجيل الدخول والخروج")

local Players = game:GetService("Players")
local TargetPlayerName = ""
local TargetUserId = nil
local LeaveCount = 0
local JoinCount = 0
local TrackingActive = false

local function FindPlayerByShortName(shortName)
    shortName = string.lower(shortName)
    for _, player in pairs(Players:GetPlayers()) do
        local pName = string.lower(player.Name)
        local pDisplayName = string.lower(player.DisplayName)
        if string.find(pName, shortName, 1, true) or string.find(pDisplayName, shortName, 1, true) then
            return player
        end
    end
    return nil
end

local StatsParagraph = Tabs.Blacklist:AddParagraph({
    Title = "إحصائيات السواد",
    Content = "اللاعب المراقب: لا يوجد\nنقاط الخروج: 0\nنقاط الدخول: 0"
})

local function UpdateStats()
    local nameDisplay = TargetPlayerName ~= "" and TargetPlayerName or "لا يوجد"
    -- استخدام الطريقة الصحيحة لتحديث محتوى الـ Paragraph في Fluent عبر خاصية Desc أو التحديث المباشر للجدول إذا كانت مدعومة، أو إشعارات مفصلة لتجنب الكراش
    pcall(function()
        StatsParagraph:SetDesc("اللاعب المراقب: " .. nameDisplay .. "\nنقاط الخروج: " .. tostring(LeaveCount) .. "\nنقاط الدخول: " .. tostring(JoinCount))
    end)
end

Tabs.Blacklist:AddInput("PlayerSearch", {
    Title = "اكتب حروف من اسم الخصم",
    Default = "",
    Placeholder = "مثال: اسم أو جزء منه",
    Numeric = false,
    Finished = true,
    Callback = function(Text)
        if #Text >= 1 then
            local target = FindPlayerByShortName(Text)
            if target then
                TargetPlayerName = target.Name
                TargetUserId = target.UserId
                TrackingActive = true
                UpdateStats()
                
                Fluent:Notify({
                    Title = "تسجيل سواد",
                    Content = "تم اختيار اللاعب: " .. TargetPlayerName,
                    Duration = 4
                })
            else
                Fluent:Notify({
                    Title = "تسجيل سواد",
                    Content = "لم يتم العثور على لاعب بهذا الاسم!",
                    Duration = 3
                })
            end
        end
    end
})

Players.PlayerRemoving:Connect(function(player)
    if TrackingActive and (player.Name == TargetPlayerName or player.UserId == TargetUserId) then
        LeaveCount = LeaveCount + 1
        UpdateStats()
        Fluent:Notify({
            Title = "تسجيل سواد | تيم الرواقي",
            Content = "خرج الخصم (" .. player.Name .. ")! نقاط الخروج: " .. tostring(LeaveCount),
            Duration = 5
        })
    end
end)

Players.PlayerAdded:Connect(function(player)
    if TrackingActive and (player.Name == TargetPlayerName or player.UserId == TargetUserId) then
        JoinCount = JoinCount + 1
        UpdateStats()
        Fluent:Notify({
            Title = "تسجيل سواد | تيم الرواقي",
            Content = "رجع دخل الخصم (" .. player.Name .. ")! نقاط الدخول: " .. tostring(JoinCount),
            Duration = 5
        })
    end
end)

