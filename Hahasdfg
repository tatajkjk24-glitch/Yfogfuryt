local showEditTools = true

local function formatTime(sec)
	local hrs = math.floor(sec / 3600)
	local mins = math.floor((sec % 3600) / 60)
	local secs = math.floor(sec % 60)
	return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

