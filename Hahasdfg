	pNameLabel.Font = Enum.Font.SourceSansBold
	pNameLabel.TextSize = 15
	pNameLabel.TextXAlignment = Enum.TextXAlignment.Left
	pNameLabel.BackgroundTransparency = 1
	pNameLabel.Parent = card

	-- العدادات
	local pStatsLabel = Instance.new("TextLabel")
	pStatsLabel.Size = UDim2.new(0.65, 0, 0, 16)
	pStatsLabel.Position = UDim2.new(0.18, 0, 0.32, 0)
	pStatsLabel.Text = "دخول: 0 | خروج: 0 | مدة: 00:00:00"
	pStatsLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	pStatsLabel.Font = Enum.Font.SourceSans
	pStatsLabel.TextSize = 12
	pStatsLabel.TextXAlignment = Enum.TextXAlignment.Left
	pStatsLabel.BackgroundTransparency = 1
	pStatsLabel.Parent = card

	-- أدوات تعديل النقاط والدخول يدوياً
	local editBox = Instance.new("TextBox")
	editBox.Size = UDim2.new(0, 70, 0, 20)
	editBox.Position = UDim2.new(0.18, 0, 0.62, 0)
	editBox.PlaceholderText = "تعديل دخول"
	editBox.Text = ""
	editBox.BackgroundColor3 = Color3.fromRGB(50, 20, 75)
	editBox.TextColor3 = Color3.fromRGB(255, 255, 255)
	editBox.Font = Enum.Font.SourceSans
	editBox.TextSize = 11
	editBox.Parent = card

	local setBtn = Instance.new("TextButton")
	setBtn.Size = UDim2.new(0, 45, 0, 20)
	setBtn.Position = UDim2.new(0.40, 0, 0.62, 0)
	setBtn.Text = "حفظ"
	setBtn.BackgroundColor3 = Color3.fromRGB(120, 30, 180)
	setBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	setBtn.Font = Enum.Font.SourceSansBold
	setBtn.TextSize = 11
	setBtn.Parent = card

	-- زر حذف ❌
	local delBtn = Instance.new("TextButton")
	delBtn.Size = UDim2.new(0, 24, 0, 24)
	delBtn.Position = UDim2.new(0.88, 0, 0.10, 0)
	delBtn.Text = "❌"
	delBtn.TextColor3 = Color3.fromRGB(255, 60, 60)
	delBtn.BackgroundTransparency = 1
	delBtn.Font = Enum.Font.SourceSansBold
	delBtn.TextSize = 14
	delBtn.Parent = card

	local data = {
		player = plr,
		joinCount = 0,
		leaveCount = 0,
		seconds = 0,
		isOnline = true,
		cardFrame = card,
		nameLabel = pNameLabel,
		statsLabel = pStatsLabel
	}

	trackedPlayers[plr.UserId] = data

	-- حفظ التعديل اليدوي
	setBtn.MouseButton1Click:Connect(function()
		local num = tonumber(editBox.Text)
		if num then
			data.joinCount = num
			data.statsLabel.Text = string.format("دخول: %d | خروج: %d | مدة: %s", data.joinCount, data.leaveCount, formatTime(data.seconds))
			editBox.Text = ""
		end
	end)

	delBtn.MouseButton1Click:Connect(function()
		trackedPlayers[plr.UserId] = nil
		card:Destroy()
	end)
end

-- البحث والإضافة
startBtn.MouseButton1Click:Connect(function()
	local text = nameInput.Text:lower()
	if #text == 0 then return end
	
	for _, p in pairs(Players:GetPlayers()) do
		if p.Name:lower():sub(1, #text) == text or p.DisplayName:lower():sub(1, #text) == text then
			addPlayerToTrack(p)
			nameInput.Text = ""
			break
		end
	end
end)

-- العداد المستمر
task.spawn(function()
	while task.wait(1) do
		mySeconds = mySeconds + 1
		myTimeLabel.Text = "مدة بقائك : " .. formatTime(mySeconds)

		for id, data in pairs(trackedPlayers) do
			if Players:FindFirstChild(data.player.Name) then
				if not data.isOnline then
					data.isOnline = true
					data.joinCount = data.joinCount + 1
				end
				data.seconds = data.seconds + 1
				data.nameLabel.Text = data.player.Name
				data.statsLabel.Text = string.format("دخول: %d | خروج: %d | مدة: %s", data.joinCount, data.leaveCount, formatTime(data.seconds))
			else
				if data.isOnline then
					data.isOnline = false
					data.leaveCount = data.leaveCount + 1
				end
				data.nameLabel.Text = data.player.Name .. " (خرج)"
				data.statsLabel.Text = string.format("دخول: %d | خروج: %d | مدة: %s", data.joinCount, data.leaveCount, formatTime(data.seconds))
			end
		end
	end
end)
