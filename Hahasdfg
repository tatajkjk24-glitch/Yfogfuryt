-- إدارة البيانات
local trackedPlayers = {}
local mySeconds = 0

local function formatTime(sec)
	local hrs = math.floor(sec / 3600)
	local mins = math.floor((sec % 3600) / 60)
	local secs = math.floor(sec % 60)
	return string.format("%02d:%02d:%02d", hrs, mins, secs)
end

-- إضافة لاعب مع أزرار التعديل اليدوي
local function addPlayerToTrack(plr)
	if trackedPlayers[plr.UserId] then return end
	
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, -8, 0, 75)
	card.BackgroundColor3 = Color3.fromRGB(22, 6, 35)
	card.BorderSizePixel = 0
	card.Parent = scrollList

	local cardCorner = Instance.new("UICorner")
	cardCorner.CornerRadius = UDim.new(0, 8)
	cardCorner.Parent = card

	-- الصورة
	local avatarImg = Instance.new("ImageLabel")
	avatarImg.Size = UDim2.new(0, 38, 0, 38)
	avatarImg.Position = UDim2.new(0.03, 0, 0.1, 0)
	avatarImg.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
	avatarImg.BackgroundTransparency = 1
	avatarImg.Parent = card

	local imgCorner = Instance.new("UICorner")
	imgCorner.CornerRadius = UDim.new(1, 0)
	imgCorner.Parent = avatarImg

	task.spawn(function()
		avatarImg.Image = Players:GetUserThumbnailAsync(plr.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
	end)

	-- الاسم
	local pNameLabel = Instance.new("TextLabel")
	pNameLabel.Size = UDim2.new(0.65, 0, 0, 18)
	pNameLabel.Position = UDim2.new(0.18, 0, 0.08, 0)
